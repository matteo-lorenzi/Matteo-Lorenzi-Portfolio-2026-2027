---
import type { Locale } from "../i18n";
import { getTranslations } from "../i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import ScrollFloat from "../components/ScrollFloat.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<BaseLayout locale={locale} title="M.L - Portfolio">
  <section class="grid-main min-h-[72vh] items-end pb-16 md:min-h-[76vh]">
    <div class="col-content reveal-item">
      <p class="text-label mb-6">{t.hero.role}</p>
      <h1 class="text-display">{t.hero.name}</h1>
      <div class="mt-10 flex items-center justify-end">
        <p class="text-label">{t.hero.scroll} ↓</p>
      </div>
    </div>
  </section>

  <section class="grid-main py-16 md:py-24">
    <div class="col-content">
      <ScrollFloat
        id={`landing-welcome-${locale}`}
        as="h2"
        text={t.landing.title}
        containerClassName="text-center"
        textClassName="leading-none"
      />

      <div
        class="mt-12 grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(340px,520px)]"
      >
        <p class="text-subheading leading-relaxed">{t.landing.subtitle}</p>
      </div>
    </div>
  </section>
</BaseLayout>
