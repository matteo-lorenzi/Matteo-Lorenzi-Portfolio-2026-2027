---
import type { Locale } from "../i18n";
import { getTranslations } from "../i18n";
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<BaseLayout locale={locale} title="M.L - Portfolio">
  <section
    aria-labelledby="hero-title"
    class="grid-main min-h-[72vh] items-end pb-16 md:min-h-[76vh]"
  >
    <div class="col-content">
      <p class="text-label mb-6" data-hero-stagger>{t.hero.role}</p>
      <h1 id="hero-title" class="text-display" data-hero-stagger>
        {t.hero.name}
      </h1>
    </div>
  </section>
</BaseLayout>

<script>
  import gsap from "gsap";
  import { cssDurationSeconds } from "../scripts/motion";

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    gsap.from("[data-hero-stagger]", {
      y: 40,
      opacity: 0,
      duration: cssDurationSeconds("--duration-slow", 0.8),
      stagger: 0.12,
      ease: "power3.out",
      // CurtainTransition couvre la page ~1s : caler l'entrée sur la levée du rideau
      delay: 1.1,
      clearProps: "all",
    });
  }
</script>
