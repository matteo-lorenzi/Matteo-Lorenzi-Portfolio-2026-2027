---
import type { Locale } from "../i18n";
import { getTranslations } from "../i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import ScrollFloat from "../components/ScrollFloat.astro";
import HeroScene from "../components/HeroScene.tsx";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<BaseLayout locale={locale} title="M.L - Portfolio">
  <section
    aria-labelledby="hero-title"
    class="hero-section grid-main min-h-[72vh] items-end pb-16 md:min-h-[76vh]"
  >
    <figure class="hero-scene">
      <HeroScene client:only="react" fallbackLabel={t.landing.modelAlt} />
      <figcaption class="sr-only">{t.landing.modelAlt}</figcaption>
    </figure>
    <div class="col-content relative z-10">
      <p class="text-label mb-6" data-hero-stagger>{t.hero.role}</p>
      <h1 id="hero-title" class="text-display" data-hero-stagger>
        {t.hero.name}
      </h1>
      <div class="mt-10 flex items-center justify-end" data-hero-stagger>
        <p class="text-label">{t.hero.scroll} ↓</p>
      </div>
    </div>
  </section>

  <section
    aria-labelledby={`landing-welcome-${locale}`}
    class="grid-main py-16 md:py-24"
  >
    <div class="col-content">
      <ScrollFloat
        id={`landing-welcome-${locale}`}
        as="h2"
        text={t.landing.title}
        containerClassName="text-center"
        textClassName="leading-none"
      />

      <div
        class="mt-12 grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(340px,520px)]"
      >
        <p class="text-subheading leading-relaxed reveal-item">
          {t.landing.subtitle}
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import gsap from "gsap";
  import { cssDurationSeconds } from "../scripts/motion";

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    gsap.from("[data-hero-stagger]", {
      y: 40,
      opacity: 0,
      duration: cssDurationSeconds("--duration-slow", 0.8),
      stagger: 0.12,
      ease: "power3.out",
      // CurtainTransition couvre la page ~1s : caler l'entrée sur la levée du rideau
      delay: 1.1,
      clearProps: "all",
    });
  }
</script>

<style>
  .hero-section {
    position: relative;
    overflow: hidden;
  }

  .hero-scene {
    position: absolute;
    inset: 0;
    margin: 0;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .hero-scene {
      left: 45%;
    }
  }
</style>
