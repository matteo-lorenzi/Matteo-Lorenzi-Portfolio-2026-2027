---
import type { Locale } from "../i18n";
import { getTranslations } from "../i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const pageTitle =
  locale === "fr"
    ? "Experience professionnelle - M.L"
    : "Professional Experience - M.L";

const isFr = locale === "fr";
const experiences = (await getCollection("experiences"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((item) => ({
    id: item.id,
    period: item.data.period,
    company: item.data.company,
    type: isFr ? item.data.type_fr : item.data.type_en,
    role: isFr ? item.data.role_fr : item.data.role_en,
    location: isFr ? item.data.location_fr : item.data.location_en,
    summary: isFr ? item.data.summary_fr : item.data.summary_en,
    highlights: isFr ? item.data.highlights_fr : item.data.highlights_en,
  }));
---

<BaseLayout locale={locale} title={pageTitle}>
  <section class="grid-main pb-16 pt-20 md:pt-24 lg:pt-32">
    <div class="col-content space-y-16">
      <header
        class="reveal-item space-y-6 border-b border-[var(--color-border)] pb-12"
      >
        <p class="text-label text-[var(--color-ink)]">
          {t.experiencePage.kicker}
        </p>
        <h1 class="text-heading">{t.experiencePage.title}</h1>
        <p class="text-body max-w-[72ch] text-[var(--color-ink)]">
          {t.experiencePage.intro}
        </p>
      </header>

      <p class="text-label">{t.experiencePage.count(experiences.length)}</p>

      <div class="experience-rail">
        <svg
          class="experience-line"
          aria-hidden="true"
          viewBox="0 0 2 100"
          preserveAspectRatio="none"
        >
          <line x1="1" y1="0" x2="1" y2="100" pathLength="1"></line>
        </svg>
        <ul class="experience-gallery" role="list">
        {
          experiences.map((item, index) => (
            <li
              class:list={[
                "reveal-item experience-card border border-[var(--color-border)] p-6 md:p-8",
                index % 3 === 0 ? "md:col-span-2" : "md:col-span-1",
              ]}
            >
              <article aria-labelledby={`experience-title-${item.id}`}>
                <div class="flex flex-wrap items-center gap-3">
                  <p class="text-label text-[var(--color-ink)]">
                    {item.period}
                  </p>
                  <span class="tag-radius border border-[var(--color-border)] px-2 py-1 text-label">
                    {item.type}
                  </span>
                </div>
                <h2
                  id={`experience-title-${item.id}`}
                  class="mt-4 text-subheading text-[var(--color-ink)]"
                >
                  {item.role}
                </h2>
                <p class="mt-2 text-body text-[var(--color-ink)]">
                  {item.company} · {item.location}
                </p>
                <p class="mt-4 text-body">{item.summary}</p>
                <ul class="mt-6 list-disc space-y-2 pl-5 text-body">
                  {item.highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              </article>
            </li>
          ))
        }
        </ul>
      </div>
    </div>
  </section>

  <script>
    import gsap from "gsap";
    import ScrollTrigger from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const line = document.querySelector(".experience-line line");
      if (line) {
        gsap.to(line, {
          strokeDashoffset: 0,
          ease: "none",
          scrollTrigger: {
            trigger: ".experience-rail",
            start: "top 80%",
            end: "bottom 60%",
            scrub: true,
          },
        });
      }
    }
  </script>

  <style is:global>
    .experience-rail {
      position: relative;
    }

    .experience-line {
      position: absolute;
      left: -24px;
      top: 0;
      height: 100%;
      width: 2px;
      overflow: visible;
    }

    .experience-line line {
      stroke: var(--color-ink);
      stroke-width: 2;
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }

    @media (max-width: 1024px) {
      .experience-line {
        display: none;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .experience-line line {
        stroke-dashoffset: 0;
      }
    }

    .experience-gallery {
      display: grid;
      gap: 1rem;
      grid-template-columns: 1fr;
    }

    .experience-card {
      position: relative;
      overflow: hidden;
      background: linear-gradient(
        145deg,
        color-mix(in srgb, var(--color-paper) 88%, var(--color-ink) 12%) 0%,
        var(--color-paper) 42%,
        color-mix(in srgb, var(--color-paper) 94%, var(--color-ink) 6%) 100%
      );
      transition: border-color var(--transition-base);
    }

    .experience-card:hover,
    .experience-card:focus-within {
      border-color: var(--color-ink);
    }

    @media (min-width: 768px) {
      .experience-gallery {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }
  </style>
</BaseLayout>
