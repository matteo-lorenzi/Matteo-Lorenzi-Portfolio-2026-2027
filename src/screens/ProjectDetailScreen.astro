---
import type { Locale } from "../i18n";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectTemplate from "../components/ProjectTemplate.astro";
import { getLocalizedProjects } from "./projectPaths";

interface Props {
  locale: Locale;
  project: CollectionEntry<"projects">;
}

const { locale, project } = Astro.props;

// Compteur et navigation ne portent que sur les projets de la locale courante,
// sinon le total doublerait depuis que chaque projet existe en fr/ et en/.
const orderedProjects = await getLocalizedProjects(locale);
const currentIndex = orderedProjects.findIndex(
  (entry) => entry.id === project.id,
);
const indexLabel = `[ ${String(currentIndex + 1).padStart(2, "0")} / ${String(orderedProjects.length).padStart(2, "0")} ]`;
const previous =
  currentIndex > 0 ? orderedProjects[currentIndex - 1] : undefined;
const next =
  currentIndex < orderedProjects.length - 1
    ? orderedProjects[currentIndex + 1]
    : undefined;
---

<BaseLayout locale={locale} title={`${project.data.title} - M.L`}>
  <ProjectTemplate
    project={project}
    locale={locale}
    indexLabel={indexLabel}
    previous={previous}
    next={next}
  />
</BaseLayout>
