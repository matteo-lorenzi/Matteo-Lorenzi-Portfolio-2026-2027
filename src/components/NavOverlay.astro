---
import type { Locale } from "../i18n";
import { getTranslations } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const currentPath = Astro.url.pathname;
const projectsPath = locale === "fr" ? "/fr/projets/" : "/en/projects/";
const experiencePath = locale === "fr" ? "/fr/experiences/" : "/en/experience/";
const aboutPath = locale === "fr" ? "/fr/a-propos/" : "/en/about/";
const contactPath = locale === "fr" ? "/fr/contact/" : "/en/contact/";
const homePath = locale === "fr" ? "/fr/" : "/en/";

const toEnglishPath = (path: string) => {
  if (path === "/fr" || path === "/fr/") return "/en/";

  return path
    .replace(/^\/fr\/a-propos(\/|$)/, "/en/about$1")
    .replace(/^\/fr\/projets(\/|$)/, "/en/projects$1")
    .replace(/^\/fr\/experiences(\/|$)/, "/en/experience$1")
    .replace(/^\/fr\//, "/en/");
};

const toFrenchPath = (path: string) => {
  if (path === "/en" || path === "/en/") return "/fr/";

  return path
    .replace(/^\/en\/about(\/|$)/, "/fr/a-propos$1")
    .replace(/^\/en\/projects(\/|$)/, "/fr/projets$1")
    .replace(/^\/en\/experience(\/|$)/, "/fr/experiences$1")
    .replace(/^\/en\//, "/fr/");
};

const localeSwitchPath =
  locale === "fr" ? toEnglishPath(currentPath) : toFrenchPath(currentPath);
const localeSwitchLabel = locale === "fr" ? "EN" : "FR";
---

<div
  id="nav-overlay"
  class="fixed inset-0 z-[120] origin-top scale-y-0 bg-[var(--color-paper)]"
>
  <div class="grid-main h-full py-8">
    <button
      id="nav-overlay-close"
      aria-label={t.nav.close}
      class="col-content ml-auto text-3xl leading-none">×</button
    >
    <div class="col-content mt-8 flex flex-col gap-4">
      <a class="overlay-link text-heading" href={homePath}>M.L</a>
      <a class="overlay-link text-heading" href={projectsPath}
        >{t.nav.projects}</a
      >
      <a class="overlay-link text-heading" href={experiencePath}
        >{t.nav.experience}</a
      >
      <a class="overlay-link text-heading" href={aboutPath}>{t.nav.about}</a>
      <a class="overlay-link text-heading" href={contactPath}>{t.nav.contact}</a
      >
    </div>
    <a class="col-content mt-auto text-label" href={localeSwitchPath}
      >{localeSwitchLabel}</a
    >
  </div>
</div>

<script>
  import gsap from "gsap";

  const overlay = document.getElementById("nav-overlay");
  const links = overlay?.querySelectorAll(".overlay-link");
  const closeBtn = document.getElementById("nav-overlay-close");
  const openBtn = document.getElementById("nav-overlay-open");

  const closeOverlay = () => {
    if (!overlay) return;
    gsap.to(overlay, {
      scaleY: 0,
      duration: 0.5,
      ease: "power3.inOut",
      transformOrigin: "top",
    });
    if (openBtn) {
      openBtn.setAttribute("aria-expanded", "false");
    }
  };

  const openOverlay = () => {
    if (!overlay) return;
    gsap.to(overlay, {
      scaleY: 1,
      duration: 0.5,
      ease: "power3.inOut",
      transformOrigin: "top",
    });

    if (links) {
      gsap.fromTo(
        links,
        { y: 40, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          delay: 0.2,
          duration: 0.6,
          stagger: 0.08,
          ease: "power3.out",
          onComplete: () => {
            gsap.set(links, { clearProps: "transform,opacity" });
          },
        },
      );
    }

    if (openBtn) {
      openBtn.setAttribute("aria-expanded", "true");
    }
  };

  openBtn?.addEventListener("click", openOverlay);
  closeBtn?.addEventListener("click", closeOverlay);
  links?.forEach((link) => link.addEventListener("click", closeOverlay));
</script>

<style>
  .overlay-link {
    display: inline-block;
    transition:
      transform 0.35s ease,
      opacity 0.25s ease;
    will-change: transform;
  }

  .overlay-link:hover,
  .overlay-link:focus-visible {
    transform: translateX(14px);
  }

  @media (prefers-reduced-motion: reduce) {
    .overlay-link {
      transition: opacity 0.2s ease;
    }

    .overlay-link:hover,
    .overlay-link:focus-visible {
      transform: none;
      opacity: 0.85;
    }
  }
</style>
