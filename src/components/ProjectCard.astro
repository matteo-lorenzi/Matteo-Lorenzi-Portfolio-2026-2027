---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  locale: "fr" | "en";
}

const { project, locale } = Astro.props;
const basePath = locale === "fr" ? "/fr/projets/" : "/en/projects/";
const projectPath = project.id.replace(/\.md$/, "");
---

<a
  href={`${basePath}${projectPath}/`}
  class="project-card reveal-item block border border-[var(--color-border)] transition duration-300 hover:border-[var(--color-ink)]"
>
  <div class="project-card__media overflow-hidden">
    <img
      src={project.data.cover}
      alt={project.data.title}
      class="project-card__image aspect-[4/3] w-full object-cover grayscale contrast-105 transition duration-500 hover:scale-[1.04] hover:grayscale-0"
      loading="lazy"
    />
  </div>
  <div class="project-card__content p-4">
    <div class="flex items-center justify-between">
      <span class="text-label"
        >[{String(project.data.order).padStart(2, "0")}]</span
      >
      <span class="text-label">{project.data.category}</span>
    </div>
    <h2 class="mt-3 text-2xl font-medium">{project.data.title}</h2>
    <p class="mt-2 text-label">{project.data.year}</p>
  </div>
</a>
