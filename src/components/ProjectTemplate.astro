---
import { render, type CollectionEntry } from "astro:content";
import type { Locale } from "../i18n";
import { getTranslations } from "../i18n";
import { projectSlug } from "../screens/projectPaths";

interface Props {
  project: CollectionEntry<"projects">;
  locale: Locale;
  indexLabel: string;
  previous?: CollectionEntry<"projects">;
  next?: CollectionEntry<"projects">;
}

const { project, locale, indexLabel, previous, next } = Astro.props;
const t = getTranslations(locale);
const { title, category, year, description, context, problem, outcome, role } =
  project.data;
const tools = project.data.tools?.length
  ? project.data.tools.join(" · ")
  : undefined;
const images = project.data.images ?? [];
const basePath = locale === "fr" ? "/fr/projets/" : "/en/projects/";

// Le corps markdown n'existe pour l'instant qu'en français : le bloc étude de
// cas disparaît tant que la version d'une locale n'est pas écrite.
const hasBody = (project.body ?? "").trim().length > 0;
const { Content } = await render(project);

// Chaque cellule de la fiche est conditionnelle : un tiret à la place du rôle
// est pire qu'une cellule absente.
const fiche = [
  { label: t.projectDetail.role, value: role },
  { label: t.projectDetail.context, value: context },
  { label: t.projectDetail.tools, value: tools },
].filter((entry) => entry.value);
---

<article class="grid-main pb-24 pt-28 md:pt-32">
  <header class="col-content reveal-item">
    <p class="text-label">{indexLabel}</p>
    <h1 class="text-display text-display--project mt-4">{title}</h1>
    <p
      class="text-label mt-6 border-t border-[var(--color-border)] pt-4"
    >
      {category} · {year}
    </p>
  </header>

  <div class="col-content mt-10 reveal-item">
    <p class="text-subheading max-w-[34ch]">{description}</p>
  </div>

  {
    fiche.length > 0 && (
      <dl class="col-content project-fiche mt-12 reveal-item">
        {fiche.map((entry) => (
          <div>
            <dt class="text-label">{entry.label}</dt>
            <dd>{entry.value}</dd>
          </div>
        ))}
      </dl>
    )
  }

  {
    problem && (
      <section class="col-content mt-12 reveal-item">
        <p class="text-label">{t.projectDetail.problem}</p>
        <p class="text-subheading mt-3 max-w-[46ch]">{problem}</p>
      </section>
    )
  }

  {
    project.data.video_url && (
      <div class="col-content mt-12 reveal-item">
        <a
          href={project.data.video_url}
          target="_blank"
          rel="noopener noreferrer"
          class="cta-animated inline-block border border-[var(--color-ink)] px-4 py-2 text-label text-[var(--color-ink)] transition-colors hover:bg-[var(--color-ink)] hover:text-[var(--color-paper)]"
        >
          {t.projectDetail.watchVideo} →
        </a>
      </div>
    )
  }

  {
    project.data.cover && (
      <div class="col-full mt-12 reveal-item">
        <img
          src={project.data.cover}
          alt={title}
          class="aspect-[16/9] w-full object-cover grayscale"
          loading="eager"
        />
      </div>
    )
  }

  {
    hasBody && (
      <section class="col-content mt-16 reveal-item">
        <p class="text-label">{t.projectDetail.caseStudy}</p>
        <div class="project-body mt-4 text-body">
          <Content />
        </div>
      </section>
    )
  }

  {
    outcome && (
      <section class="col-content mt-12 reveal-item">
        <div class="project-outcome">
          <p class="text-label">{t.projectDetail.outcome}</p>
          <p class="text-subheading mt-3">{outcome}</p>
        </div>
      </section>
    )
  }

  {
    images.length > 0 && (
      <div class="col-content mt-12 grid grid-cols-1 gap-6 lg:grid-cols-2 reveal-item">
        {images.map((image, idx) => (
          <img
            src={image}
            alt={`${title} — ${idx + 1}`}
            class="aspect-[4/3] w-full object-cover grayscale"
            loading="lazy"
          />
        ))}
      </div>
    )
  }

  <nav
    class="col-content mt-16 grid grid-cols-1 gap-3 border-t border-[var(--color-border)] pt-6 text-label reveal-item md:grid-cols-3 md:items-center"
    aria-label={t.projectDetail.navLabel}
  >
    {
      previous ? (
        <a
          href={`${basePath}${projectSlug(previous)}/`}
          class="project-detail-nav-link md:justify-self-start"
        >
          {t.projectDetail.prev}
        </a>
      ) : (
        <span class="hidden md:block" />
      )
    }
    <a href={basePath} class="project-detail-nav-link md:justify-self-center"
      >{t.projectDetail.backToList}</a
    >
    {
      next ? (
        <a
          href={`${basePath}${projectSlug(next)}/`}
          class="project-detail-nav-link md:justify-self-end"
        >
          {t.projectDetail.next}
        </a>
      ) : (
        <span class="hidden md:block" />
      )
    }
  </nav>
</article>
