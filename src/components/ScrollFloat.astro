---
interface Props {
  id: string;
  text: string;
  as?: "h1" | "h2";
  containerClassName?: string;
  textClassName?: string;
  animationDuration?: number;
  ease?: string;
  scrollStart?: string;
  scrollEnd?: string;
  stagger?: number;
}

const {
  id,
  text,
  as = "h1",
  containerClassName = "",
  textClassName = "",
  animationDuration = 1,
  ease = "back.inOut(2)",
  scrollStart = "center bottom+=50%",
  scrollEnd = "bottom bottom-=40%",
  stagger = 0.03,
} = Astro.props;

const Tag = as;
const chars = Array.from(text);
---

<Tag
  id={id}
  class={`scroll-float ${containerClassName}`}
  aria-label={text}
  data-animation-duration={animationDuration}
  data-ease={ease}
  data-scroll-start={scrollStart}
  data-scroll-end={scrollEnd}
  data-stagger={stagger}
>
  {/* aria-hidden : le texte est \u00E9clat\u00E9 en spans par caract\u00E8re, les lecteurs
      d'\u00E9cran liraient lettre \u00E0 lettre \u2014 l'aria-label du conteneur porte le texte */}
  <span class={`scroll-float-text ${textClassName}`} aria-hidden="true">
    {
      chars.map((char) => (
        <span class="char">{char === " " ? "\u00A0" : char}</span>
      ))
    }
  </span>
</Tag>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document
      .querySelectorAll<HTMLElement>(".scroll-float[id]")
      .forEach((el) => {
        const chars = el.querySelectorAll(".char");
        const animationDuration = Number(el.dataset.animationDuration ?? "1");
        const ease = el.dataset.ease ?? "back.inOut(2)";
        const scrollStart = el.dataset.scrollStart ?? "center bottom+=50%";
        const scrollEnd = el.dataset.scrollEnd ?? "bottom bottom-=40%";
        const stagger = Number(el.dataset.stagger ?? "0.03");

        gsap.fromTo(
          chars,
          {
            willChange: "opacity, transform",
            opacity: 0,
            yPercent: 120,
            scaleY: 2.3,
            scaleX: 0.7,
            transformOrigin: "50% 0%",
          },
          {
            duration: animationDuration,
            ease,
            opacity: 1,
            yPercent: 0,
            scaleY: 1,
            scaleX: 1,
            stagger,
            scrollTrigger: {
              trigger: el,
              start: scrollStart,
              end: scrollEnd,
              scrub: true,
            },
          },
        );
      });
  }
</script>

<style>
  .scroll-float {
    overflow: hidden;
  }

  .scroll-float-text {
    display: inline-block;
    font-size: clamp(1.6rem, 8vw, 10rem);
    font-weight: 900;
    text-align: center;
    line-height: 1.5;
  }

  .char {
    display: inline-block;
  }
</style>
