---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { t } from "../../i18n/en";
import ProjectCard from "../../components/ProjectCard.astro";

const projects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout locale="en" title="M.L - Portfolio">
  <section class="grid-main min-h-[72vh] items-end pb-16 md:min-h-[76vh]">
    <div class="col-content reveal-item">
      <p class="text-label mb-6">{t.hero.role}</p>
      <h1 class="text-display">{t.hero.title}</h1>
      <div class="mt-10 flex items-center justify-end">
        <p class="text-label">{t.hero.scroll} ↓</p>
      </div>
    </div>
  </section>

  <section class="grid-main py-16">
    <div class="col-content space-y-10">
      <h2 class="text-heading">{t.projects.title}</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {
          projects.map((project) => (
            <ProjectCard project={project} locale="en" />
          ))
        }
      </div>
    </div>
  </section>

  <section id="about" class="grid-main my-16 py-16">
    <div
      class="col-content reveal-item border-y border-[var(--color-border)] py-10 text-center"
    >
      <p class="text-subheading">{t.about.strip}</p>
    </div>
  </section>
</BaseLayout>
